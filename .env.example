# Used server-side only, in src/app/api/commentary/route.ts — generates
# the AI market/portfolio commentary section of the report from
# already-computed performance and holdings data. Never exposed to the
# client (no NEXT_PUBLIC_ prefix). Every other number in the report is
# plain TypeScript arithmetic and needs no API key at all.
GEMINI_API_KEY=
# Optional override — defaults to gemini-flash-latest (a live-updating
# alias) if unset.
GEMINI_MODEL=
